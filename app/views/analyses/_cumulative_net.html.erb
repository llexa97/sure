<%# locals: (analysis:) %>

<%= render DS::Card.new(class: "gap-4 h-full", aria: { labelledby: "cumulative-net-title" }) do %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 id="cumulative-net-title" class="text-lg font-medium text-primary"><%= t("analyses.show.cumulative.title") %></h2>
      <p class="mt-1 text-sm text-secondary"><%= t("analyses.show.cumulative.description", year: analysis.cashflow_year) %></p>
    </div>
    <div class="text-right shrink-0">
      <p class="text-xs text-secondary"><%= t("analyses.show.cumulative.current") %></p>
      <p class="mt-1 text-xl font-semibold privacy-sensitive <%= analysis.annual_summary[:net].negative? ? "text-destructive" : "text-success" %>">
        <%= analysis.annual_summary[:net].format %>
      </p>
    </div>
  </div>

  <% if analysis.has_annual_cashflow? %>
    <%= tag.div(
      id: "annualCumulativeNetChart",
      class: "w-full min-h-52 privacy-sensitive",
      role: "img",
      aria: { label: t("analyses.show.cumulative.aria_label", year: analysis.cashflow_year) },
      data: {
        controller: "time-series-chart",
        time_series_chart_data_value: analysis.cumulative_net_series.to_json,
        time_series_chart_use_labels_value: false
      }
    ) %>
    <div class="flex justify-between text-xs text-secondary">
      <span><%= l(analysis.annual_period.start_date, format: :long) %></span>
      <span><%= l(analysis.annual_period.end_date, format: :long) %></span>
    </div>
  <% else %>
    <%= render DS::EmptyState.new(
      icon: "chart-line",
      title: t("analyses.show.cumulative.empty_title"),
      description: t("analyses.show.cumulative.empty_description")
    ) %>
  <% end %>
<% end %>
