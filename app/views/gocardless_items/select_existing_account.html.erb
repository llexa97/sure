<div class="space-y-4">
  <h1 class="text-primary text-xl font-medium">Link existing account to GoCardless</h1>

  <%= form_with url: link_existing_account_gocardless_items_path, method: :post, local: true, class: "space-y-3" do %>
    <%= hidden_field_tag :account_id, @account.id %>
    <%= select_tag :gocardless_account_id, options_for_select(@available_gocardless_accounts.map { |a| [a.name, a.id] }), class: "form-field__input" %>
    <%= submit_tag "Link account", class: "btn btn--primary" %>
  <% end %>
</div>
