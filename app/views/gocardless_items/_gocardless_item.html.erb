<%# locals: (gocardless_item:) %>

<%= tag.div id: dom_id(gocardless_item) do %>
  <details open class="group bg-container p-4 shadow-border-xs rounded-xl">
    <summary class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90" %>

        <div class="flex items-center justify-center h-8 w-8 bg-blue-600/10 rounded-full">
          <% if gocardless_item.institution_logo.present? %>
            <%= image_tag gocardless_item.institution_logo, class: "rounded-full h-full w-full", loading: "lazy" %>
          <% else %>
            <%= tag.p (gocardless_item.institution_name || gocardless_item.name).first.upcase, class: "text-blue-600 text-xs font-medium" %>
          <% end %>
        </div>

        <div class="pl-1 text-sm">
          <div class="flex items-center gap-2">
            <%= tag.p (gocardless_item.institution_name || gocardless_item.name), class: "font-medium text-primary" %>
            <% if gocardless_item.scheduled_for_deletion? %>
              <p class="text-destructive text-sm animate-pulse">Suppression en cours…</p>
            <% end %>
          </div>
          <% if gocardless_item.syncing? %>
            <div class="text-secondary flex items-center gap-1">
              <%= icon "loader", size: "sm", class: "animate-spin" %>
              <span>Synchronisation…</span>
            </div>
          <% else %>
            <p class="text-secondary">
              <% if gocardless_item.last_synced_at %>
                Dernière synchro : <%= time_ago_in_words(gocardless_item.last_synced_at) %>
              <% else %>
                Jamais synchronisé
              <% end %>
            </p>
          <% end %>
        </div>
      </div>

      <% if Current.user&.admin? %>
        <div class="flex items-center gap-2">
          <%= icon(
            "refresh-cw",
            as_button: true,
            href: sync_gocardless_item_path(gocardless_item)
          ) %>

          <%= render DS::Menu.new do |menu| %>
            <% menu.with_item(
              variant: "button",
              text: "Supprimer",
              icon: "trash-2",
              href: gocardless_item_path(gocardless_item),
              method: :delete,
              confirm: CustomConfirm.for_resource_deletion((gocardless_item.institution_name || gocardless_item.name), high_severity: true)
            ) %>
          <% end %>
        </div>
      <% end %>
    </summary>

    <% unless gocardless_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if gocardless_item.accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: gocardless_item.accounts %>
        <% else %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm">Aucun compte lié</p>
            <p class="text-secondary text-sm">Termine la configuration pour importer tes comptes.</p>
            <%= render DS::Link.new(
              text: "Configurer les comptes",
              icon: "settings",
              variant: "primary",
              href: setup_accounts_gocardless_item_path(gocardless_item),
              frame: :modal
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  </details>
<% end %>
