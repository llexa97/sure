<% content_for :header_nav do %>
  <%= render "settings/nav" %>
<% end %>

<div class="space-y-4">
  <h1 class="text-primary text-xl font-medium">Connect GoCardless</h1>

  <%= form_with url: new_gocardless_item_path, method: :get, local: true, class: "space-y-3" do |form| %>
    <div>
      <%= form.label :country, "Country code", class: "text-sm text-secondary" %>
      <%= form.text_field :country, value: @country, class: "form-field__input", maxlength: 2 %>
    </div>
    <%= form.submit "Load banks", class: "btn btn--primary" %>
  <% end %>

  <% if @institutions.any? %>
    <%= form_with url: gocardless_items_path, method: :post, local: true, class: "space-y-3" do |form| %>
      <%= hidden_field_tag :country, @country %>
      <div>
        <%= label_tag :institution_id, "Bank", class: "text-sm text-secondary" %>
        <%= select_tag :institution_id, options_for_select(@institutions.map { |i| [i[:name], i[:id]] }), class: "form-field__input" %>
      </div>
      <%= form.submit "Connect bank", class: "btn btn--primary" %>
    <% end %>
  <% end %>
</div>
