<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: "Select Powens accounts") %>
    <% dialog.with_body do %>
      <div class="space-y-4">
        <% if @powens_accounts.any? %>
          <%= form_with url: complete_account_setup_powens_item_path(@powens_item), method: :post, local: true, class: "space-y-3", data: { turbo_frame: :_top } do %>
            <% @powens_accounts.each do |account| %>
              <label class="flex items-center gap-3 p-3 bg-container rounded-lg">
                <%= check_box_tag "account_ids[]", account.id, true %>
                <span>
                  <span class="block text-primary"><%= account.name %></span>
                  <span class="block text-secondary text-sm"><%= account.currency %> &middot; <%= account.current_balance %></span>
                </span>
              </label>
            <% end %>

            <%= submit_tag "Link selected accounts", class: "btn btn--primary" %>
          <% end %>
        <% else %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm">No unlinked Powens accounts</p>
            <p class="text-secondary text-sm">All discovered accounts are already linked.</p>
            <%= render DS::Link.new(text: "Back to accounts", icon: "arrow-left", variant: "primary", href: accounts_path, frame: :_top) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
