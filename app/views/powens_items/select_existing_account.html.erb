<%= turbo_frame_tag "modal" do %>
  <%= render DS::Dialog.new do |dialog| %>
    <% dialog.with_header(title: "Link existing account to Powens") %>
    <% dialog.with_body do %>
      <div class="space-y-4">
        <% if @available_powens_accounts.any? %>
          <%= form_with url: link_existing_account_powens_items_path, method: :post, local: true, class: "space-y-3", data: { turbo_frame: :_top } do %>
            <%= hidden_field_tag :account_id, @account.id %>
            <%= select_tag :powens_account_id, options_for_select(@available_powens_accounts.map { |a| [a.name, a.id] }), class: "form-field__input" %>
            <%= submit_tag "Link account", class: "btn btn--primary" %>
          <% end %>
        <% else %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm">No Powens accounts available</p>
            <p class="text-secondary text-sm">Connect a bank with Powens first, then link it here.</p>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
