<%# locals: (account_group:, mobile: false, all_tab: false, open: nil, **args) %>

<div id="<%= account_group.dom_id(tab: all_tab ? :all : nil, mobile: mobile) %>" data-group-key="<%= account_group.key %>">
  <% is_open = open.nil? ? (account_group.accounts.any? { |account| page_active?(account_path(account)) } || Current.user.always_expanded_account_group?(account_group.key)) : open %>
  <%= render DS::Disclosure.new(align: :left, open: is_open) do |disclosure| %>
    <% disclosure.with_summary_content do %>
      <div class="flex items-center gap-3">
        <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90" %>
        <%= tag.span class: class_names("text-sm text-primary font-medium", "animate-pulse" => account_group.syncing?) do %>
          <%= account_group.name %>
        <% end %>
      </div>

      <div class="ml-auto text-right grow">
        <%= tag.p format_money(account_group.total_money), class: "text-sm font-medium text-primary privacy-sensitive" %>
        <%= turbo_frame_tag "#{account_group.key}_sparkline", src: accountable_sparkline_path(account_group.key), loading: "lazy", data: { controller: "turbo-frame-timeout", turbo_frame_timeout_timeout_value: 10000 } do %>
          <div class="flex items-center w-8 h-4 ml-auto">
            <div class="w-6 h-px bg-loader"></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-1">
      <% if account_group.grouped_by_subtype? %>
        <% account_group.subtype_groups.each do |subtype_group| %>
          <%= render DS::Disclosure.new(
            open: true,
            class: "group/account-subtype",
            summary_class: "px-3 py-2 min-h-11 flex items-center justify-between gap-3 text-xs font-medium text-secondary list-none cursor-pointer rounded-lg hover:bg-surface-hover focus-ring",
            body_class: "space-y-1",
            data: {
              testid: "account-subtype-group",
              account_subtype: subtype_group.key,
              controller: "persisted-disclosure",
              persisted_disclosure_key_value: "sidebar:#{Current.user.id}:#{account_group.key}:#{subtype_group.key}"
            }
          ) do |subtype_disclosure| %>
            <% subtype_disclosure.with_summary_content do %>
              <div class="flex items-center gap-2 min-w-0">
                <%= icon "chevron-right", size: "sm", class: "shrink-0 group-open/account-subtype:rotate-90 motion-safe:transition-transform" %>
                <%= tag.span class: class_names("truncate", "animate-pulse" => subtype_group.syncing?) do %>
                  <%= subtype_group.name %> &middot; <%= subtype_group.accounts.size %>
                <% end %>
              </div>
              <%= tag.span format_money(subtype_group.total_money), class: "privacy-sensitive whitespace-nowrap" %>
            <% end %>

            <% subtype_group.accounts.each do |account| %>
              <%= render "accounts/accountable_group_account", account: account, account_group: account_group %>
            <% end %>
          <% end %>
        <% end %>
      <% else %>
        <% account_group.accounts.each do |account| %>
          <%= render "accounts/accountable_group_account", account: account, account_group: account_group %>
        <% end %>
      <% end %>
    </div>

    <div class="my-2">
      <%= render DS::Link.new(
      href: new_polymorphic_path(account_group.key, step: "method_select"),
      text: t("accounts.sidebar.new_account_group", account_group: account_group.accountable_type.singular_display_name.downcase),
      icon: "plus",
      full_width: true,
      variant: "ghost",
      frame: :modal,
      class: "justify-start"
    ) %>
    </div>
  <% end %>
</div>
